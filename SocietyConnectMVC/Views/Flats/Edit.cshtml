@model Flat

<div class="container">
    <h2 class="text-center mb-4">Edit Flat Details</h2>

    <form asp-controller="Flats" asp-action="Edit" method="post">
        <div class="form-group">
            <label for="flat_no">Flat Number</label>
            <input asp-for="flat_no" class="form-control form-control-sm" placeholder="Enter Flat Number" />
            <span asp-validation-for="flat_no" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="floor_no">Floor Number</label>
            <input asp-for="floor_no" class="form-control form-control-sm" placeholder="Enter Floor Number" />
            <span asp-validation-for="floor_no" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="block_no">Block Number</label>
            <input asp-for="block_no" class="form-control form-control-sm" placeholder="Enter Block Number" />
            <span asp-validation-for="block_no" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="flat_type">Flat Type</label>
            <select asp-for="flat_type" class="form-control form-control-sm">
                <option value="" disabled>Select Flat Type</option>
                <option>1RK</option>
                <option>1BHK</option>
                <option>2BHK</option>
                <option>3BHK</option>
            </select>
            <span asp-validation-for="flat_type" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary btn-custom">Save</button>
        </div>
    </form>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}

<style>

    .container {
        max-width: 600px;
        margin-top: 50px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        padding: 8px;
        font-size: 1rem;
        width: 100%;

    .form-control-sm {
        width: 50%;
    }

    .btn-custom {
        width: 100%;
        padding: 10px;
        font-size: 1.1rem;
    }
</style>
