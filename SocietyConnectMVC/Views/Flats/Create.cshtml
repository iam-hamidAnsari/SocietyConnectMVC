@model Flat

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <h3 class="text-center mb-4" style="color: #2C3E50;">Add New Flat</h3>

        <form asp-controller="Flats" asp-action="Create" method="post">
            <div class="mb-3">
                <label for="flat_no" class="form-label">Flat Number</label>
                <input asp-for="flat_no" class="form-control" placeholder="Enter Flat Number" />
                <span asp-validation-for="flat_no" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="floor_no" class="form-label">Floor Number</label>
                <input asp-for="floor_no" class="form-control" placeholder="Enter Floor Number" />
                <span asp-validation-for="floor_no" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="block_no" class="form-label">Block Number</label>
                <input asp-for="block_no" class="form-control" placeholder="Enter Block Number" />
                <span asp-validation-for="block_no" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="flat_type" class="form-label">Flat Type</label>
                <select asp-for="flat_type" class="form-control">
                    <option value="" disabled>Select Flat Type</option>
                    <option>1RK</option>
                    <option>1BHK</option>
                    <option>2BHK</option>
                    <option>3BHK</option>
                </select>
                <span asp-validation-for="flat_type" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-success">Add Flat</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>

    .card {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        font-weight: bold;
        color: #333;
    }

    .btn-success {
        background-color: #2ECC71;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        padding: 10px 20px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #27AE60;
        }

    .container {
        max-width: 600px;
    }


    .mb-3 {
        margin-bottom: 1.5rem;
    }
</style>
