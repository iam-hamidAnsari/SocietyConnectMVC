@model IEnumerable<Flat>

<div class="container mt-4">
    <h2 class="text-center mb-4" style="color: black;">Flat Management</h2>


    <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" action="@Url.Action("Search", "Flats")" class="d-flex align-items-center">
            <input type="text" name="searchTerm" placeholder="Search Flats" class="form-control me-2" />
            <button type="submit" class="btn btn-secondary me-2">Search</button>
        </form>
        <a asp-controller="Flats" asp-action="Create" class="btn btn-success">Add Flat</a>
    </div>



    <div class="card shadow-lg p-4">
        <h3>Available Flats</h3>
        <table class="styled-gridview table table-bordered">
            <thead>
                <tr>
                    <th>Flat Number</th>
                    <th>Block Number</th>
                    <th>Floor Number</th>
                    <th>Flat Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flat in Model)
                {
                    <tr>
                        <td>@flat.flat_no</td>
                        <td>@flat.block_no</td>
                        <td>@flat.floor_no</td>
                        <td>@flat.flat_type</td>
                        <td>
                            <div class="d-flex justify-content-around">
                                <a asp-controller="Flats" asp-action="View" asp-route-id="@flat.id" class="btn btn-info btn-sm mr-1">View</a>
                                <a asp-controller="Flats" asp-action="Edit" asp-route-id="@flat.id" class="btn btn-warning btn-sm mr-1">Update</a>
                                <a asp-controller="Flats" asp-action="Delete" asp-route-id="@flat.id" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this flat?');">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>

    .styled-gridview {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 16px;
    }

    .styled-gridview th {
        background-color: white;
        color: black;
        padding-top: 12px;
        padding-bottom: 12px;
        text-align: center;
    }

    .styled-gridview td {
        padding: 8px;
        text-align: left;
        border: 1px solid #ddd;
    }

    .styled-gridview tr:hover {
        background-color: #f2f2f2;
    }

    .styled-gridview .btn {
        padding: 4px 8px;
        font-size: 14px;
    }

    #lblNoRecords {
        display: block;
        text-align: center;
        font-size: 18px;
        color: #999;
        padding: 10px;
    }
</style>

