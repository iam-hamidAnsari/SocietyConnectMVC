@model FlatAlltmnt



<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <h3 class="text-center mb-4" style="color: #2C3E50;">Edit Flat Allotment Details</h3>

        <form asp-action="Edit" asp-controller="FlatAllotment" method="post">
            <div class="mb-3">
                <label for="AllottedTo" class="form-label">Username</label>
                <select asp-for="AllottedTo" asp-items="ViewBag.Users" class="form-control">
                    <option value="">Select Username</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="FlatNo" class="form-label">Flat Number</label>
                <select asp-for="FlatNo" asp-items="ViewBag.Flats" class="form-control" disabled>
                    <option value="">Select Flat</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="MoveInDt" class="form-label">Move-In Date</label>
                <input asp-for="MoveInDt" type="date" class="form-control" />
                <span asp-validation-for="MoveInDt" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="MoveOutDt" class="form-label">Move-Out Date</label>
                <input asp-for="MoveOutDt" type="date" class="form-control" />
                <span asp-validation-for="MoveOutDt" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-success btn-custom">Save</button>
            </div>
        </form>
    </div>
</div>

<style>
    .card {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        font-weight: bold;
        color: #333;
    }

    .btn-success {
        background-color: #2ECC71;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        padding: 10px 20px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #27AE60;
        }

    .container {
        max-width: 600px;
    }

    .btn-custom {
        width: 100%;
        padding: 10px;
        font-size: 1.1rem;
    }
</style>
