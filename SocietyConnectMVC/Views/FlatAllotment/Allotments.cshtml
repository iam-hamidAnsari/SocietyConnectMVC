@model IEnumerable<FlatAlltmnt>

<div class="container mt-4">
    <h2 class="text-center mb-4" style="color: black;">Flat Allotment List</h2>


    <a href="@Url.Action("Create", "FlatAllotment")" class="btn btn-success">Add New Allocation</a>


    <div class="card shadow-lg p-4">
        <table class="GridView table table-bordered">
            <thead>
                <tr>
                    <th>Allotted To</th>
                    <th>Flat Number</th>
                    <th>Move-In Date</th>
                    <th>Move-Out Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var allotment in Model)
                {
                    <tr>
                        <td>@allotment.AllottedTo</td>
                        <td>@allotment.FlatNo</td>
                        <td>@allotment.MoveInDt</td>
                        <td>@allotment.MoveOutDt</td>
                        <td>
                            <div class="d-flex justify-content-around">
                                <a href="@Url.Action("Edit", "FlatAllotment", new { id = allotment.Id })" class="btn btn-warning btn-sm mr-1">Edit</a>
                                <a href="@Url.Action("Details", "FlatAllotment", new { id = allotment.Id })" class="btn btn-info btn-sm mr-1">View</a>
                                <a href="@Url.Action("Delete", "FlatAllotment", new { id = allotment.Id })" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this flat?');">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Styling -->
<style>
    /* Styling for GridView */
    .GridView {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 16px;
    }

        /* Style for table headers */
        .GridView th {
            background-color: white; /* Black color */
            color: black;
            padding-top: 12px;
            padding-bottom: 12px;
            text-align: center;
        }

        /* Style for table rows */
        .GridView td {
            padding: 8px;
            text-align: left;
            border: 1px solid #ddd;
        }

        /* Hover effect for rows */
        .GridView tr:hover {
            background-color: #f2f2f2;
        }

        /* Styling for Action Buttons */
        .GridView .btn {
            padding: 4px 8px;
            font-size: 14px;
            border-radius: 5px;
        }

    .btn-add {
        padding: 10px 20px;
        background-color: #2ECC71; /* Green color */
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-add:hover {
            background-color: #27AE60; /* Darker green on hover */
        }


    .btn-warning {
        background-color: #2980B9;
    }

    .btn-info {
        background-color: #27AE60;
    }

    .btn-danger {
        background-color: #E74C3C;
    }

        .btn-warning:hover, .btn-info:hover, .btn-danger:hover {
            background-color: #3498DB;
        }
</style>

