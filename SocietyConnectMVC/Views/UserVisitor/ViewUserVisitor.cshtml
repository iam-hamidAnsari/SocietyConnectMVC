@model IEnumerable<Visitor>


<style>
    .form-section {
        background-color: #ffffff;
        padding: 30px;
        display: flex;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
        flex-direction: column;
    }

    .form-title {
        color: #333;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
        border-bottom: 3px solid #000;
        display: inline-block;
        padding-bottom: 10px;
    }

    .highlight {
        color: #ffc451;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .grid-view-header {
        background-color: black;
        color: white;
        text-align: center;
    }

    .btn-custom {
        
        color: black;
        font-size: 0.9rem;
    }

    .search-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 20px;
        background-color: #ffffff;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .search-container input {
            width: 60%;
            padding: 8px;
            font-size: 1rem;
            border-radius: 5px;
            border: 1px solid #ccc;
            margin-right: 10px;
        }

        .search-container button {
            padding: 10px 15px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
            margin-left: 10px;
        }

            .search-container button#btnSearch {
                background-color: black;
                border: none;
                color: white;
            }

            .search-container button#btnAddVisitor {
                background-color: #ffc451;
                border: none;
                color: white;
                margin-left: 10px;
            }

            .search-container button:hover {
                opacity: 0.9;
            }

    .action-buttons {
        display: flex;
        gap: 5px;
    }

    .grid-view-header th {
        padding: 12px;
    }


    .search-bar-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 50%;
    }

        .search-bar-container form {
            display: flex;
            flex-grow: 1;
        }


    .add-visitor-container {
        padding: 10px 15px;
        font-size: 1rem;
        cursor: pointer;
        border-radius: 5px;
        margin-left: 10px;
        margin-left: auto;
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }
</style>

<div class="container form-section">
    <h2 class="form-title">Visitor <span class="highlight">Details</span></h2>


    <div class="search-container">

        <div class="search-bar-container">
            <form method="get" action="@Url.Action("Search", "UserVisitor")">
                <input type="text" name="searchTerm" placeholder="Search Visitors" class="form-control" />
                <button type="submit" id="btnSearch" class="form-control">Search</button>
            </form>
        </div>


        <div class="add-visitor-container">
            <a href="@Url.Action("Add", "UserVisitor")" id="btnAddVisitor" class="btn btn-custom">Add Visitor</a>
        </div>
    </div>


    <table class="table table-bordered table-hover">
        <thead class="grid-view-header">
            <tr>
                <th>Visitor ID</th>
                <th>Flat Number</th>
                <th>Visitor Name</th>
                <th>Contact Number</th>
                <th>Person to Meet</th>
                <th>Reason of Visit</th>
                <th>In Time</th>
                <th>Out Time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var visitor in Model)
                {
                    <tr>
                        <td>@visitor.id</td>
                        <td>@visitor.alloted_flats</td>
                        <td>@visitor.visitor_name</td>
                        <td>@visitor.visitor_contact</td>
                        <td>@visitor.meet_to</td>
                        <td>@visitor.purpose</td>
                        <td>@visitor.check_in_dt</td>
                        <td>@visitor.check_out_dt</td>
                        <td class="action-buttons">
                            <a href="@Url.Action("View", "UserVisitor", new { id = visitor.id })" class="btn btn-info btn-sm btn-custom">View</a>
                            <a href="@Url.Action("Edit", "UserVisitor", new { id = visitor.id })" class="btn btn-warning btn-sm btn-custom">Edit</a>
                            <a href="@Url.Action("Delete", "UserVisitor", new { id = visitor.id })" class="btn btn-danger btn-sm btn-custom" onclick="return confirm('Are you sure you want to delete this visitor?');">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

