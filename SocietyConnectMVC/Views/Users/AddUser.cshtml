
@model User
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
    }

    .profile-container {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-top: 50px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .profile-image {
        max-width: 150px;
        max-height: 150px;
        border-radius: 50%;
        margin-top: 10px;
    }

    .form-group label {
        font-weight: bold;
        color: #333;
    }

    h2 {
        color: #000;
        margin-bottom: 20px;
        font-weight: bold;
        border-bottom: 3px solid #ffc107;
        display: inline-block;
        padding-bottom: 10px;
    }

    .highlight {
        color: #ffc107;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }


    .form-group input {
        margin-bottom: 15px;
    }
</style>





    <form method="post" asp-antiforgery="true" enctype="multipart/form-data">
        <div class="container profile-container">
    <h2 class="text-center">Add <span class="highlight">User</span></h2>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label for="Name">Name:</label>
                    <input asp-for="Name" class="form-control" id="Name" placeholder="Enter full name" />
                </div>

                <div class="form-group">
                    <label for="Email">Email Id:</label>
                    <input asp-for="Email" type="email" class="form-control" id="Email" placeholder="Enter email address" />
                </div>

                <div class="form-group">
                    <label for="Password">Password:</label>
                    <input asp-for="Password" type="password" class="form-control" id="Password" placeholder="Enter password" autocomplete="current-password" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success btn-lg">Add User</button>
                </div>
            </div>
        </div>
    </form>
</div>
