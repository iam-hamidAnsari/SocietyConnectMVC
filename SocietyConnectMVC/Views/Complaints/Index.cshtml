@model IEnumerable<Complaint>


<style>
    .styled-gridview {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-size: 16px;
        text-align: left;
    }

        .styled-gridview th, .styled-gridview td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .styled-gridview th {
            background-color: black;
            color: white;
            text-align: center;
            font-weight: bold;
        }

        .styled-gridview tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .styled-gridview tr:hover {
            background-color: #ddd;
        }

    #lblNoRecords {
        text-align: center;
        font-size: 18px;
        color: #999;
        padding: 10px;
    }

    .btn {
        padding: 4px 8px;
        font-size: 14px;
    }
</style>

<div class="container mt-4">
    <h2 style="text-align: center; font-weight: bold;">Complaint Management</h2>


    <div class="search-container d-flex justify-content-between align-items-center mb-4">
        <form asp-action="Search" class="d-flex">
            <input type="text" class="form-control search-box me-2" placeholder="Search Complaints..." name="query" />
            <button type="submit" class="btn-sm btn-secondary">Search</button>
        </form>
    </div>


    <!-- Complaints Table -->
    @if (Model != null && Model.Any())
    {
        <table class="styled-gridview">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>User Name</th>
                    <th>Flat Number</th>
                    <th>Complaint</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model)
                {
                    <tr>
                        <td>@complaint.Id</td>
                        <td>@complaint.User_Email</td>
                        <td>@complaint.AllotedFlat</td>
                        <td>@complaint.Description</td>

                        @if (complaint.Status == "Pending")
                        {
                            <td><span class="badge badge-warning">@complaint.Status</span></td>
                        }
                        else if (complaint.Status == "in progress")
                        {
                            <td><span class="badge badge-primary">@complaint.Status</span></td>
                        }
                        else
                        {
                            <td><span class="badge badge-success">@complaint.Status</span></td>
                        }

                        <td>@complaint.CreatedAt.ToString()</td>
                        <td>
                            <a asp-action="View" asp-route-id="@complaint.Id" class="btn btn-info btn-sm mr-1">View</a>

                            @if (complaint.Status == "Pending")
                            {
                                <a asp-action="Edit" asp-route-id="@complaint.Id" class="btn btn-warning btn-sm mr-1">Edit</a>
                                <a href="@Url.Action("Delete", "Complaints", new { id = complaint.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this complaint?');">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="no-records">No records found</div>
    }
</div>
