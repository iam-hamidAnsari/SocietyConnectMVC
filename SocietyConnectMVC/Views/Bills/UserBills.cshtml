
@model List<Bill>


<div class="container mt-4">
    <h2 class="text-center mb-4" style="color: black;">Bill Management</h2>


    <div class="search-container d-flex justify-content-between align-items-center mb-4">
        <form method="post" class="d-flex">
            <input type="text" class="form-control search-box me-2" placeholder="Search Bill" name="search" />
            <button type="submit" class="btn-sm btn-secondary">Search</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <label id="lblNoRecords" class="text-center">No records found.</label>
    }
    else
    {
        <table class="styled-gridview">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Flat No</th>
                    <th>Bill Type</th>
                    <th>Amount</th>
                    <th>Month</th>
                    <th>Bills</th>
                    <th>Paid Staus</th>
                    <th>Created At</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model)
                {
                    <tr>
                        <td>@bill.Id</td>
                        <td>@bill.FlatNo</td>
                        <td>@bill.BillTitle</td>
                        <td>@bill.Amount</td>
                        <td>@bill.Month</td>
                        <td>
                            <a href="@Url.Content($"~/{bill.BillPdf}")" download="Bill.pdf" class="btn btn-primary btn-sm">Download</a>
                        </td>
                        @if (bill.Paid_Amount == "Not Paid")
                        {
                            <td class="text-danger">@bill.Paid_Amount</td>
                        }
                        else
                        {
                            <td class="text-success">@bill.Paid_Amount</td>
                        }
                        <td>@bill.CreatedAt</td>
                        <td>
                            <a asp-controller="Bills" asp-action="ViewUserBill" asp-route-id="@bill.Id" class="btn btn-success btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>


<style>
    .styled-gridview {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-size: 16px;
        text-align: left;
    }

        .styled-gridview th, .styled-gridview td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .styled-gridview th {
            background-color: black;
            color: white;
            padding-top: 12px;
            padding-bottom: 12px;
            text-align: center;
            font-weight: bold;
        }

        .styled-gridview tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .styled-gridview tr:hover {
            background-color: #ddd;
        }

    .search-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .search-container .search-box {
            width: 200px;
        }

        .search-container .add-button {
            margin-left: auto;
        }
</style>

