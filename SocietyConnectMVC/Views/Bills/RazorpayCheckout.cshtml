<div style="text-align: center; margin-top: 20%; font-family: Arial, sans-serif;">
    <h1>Your Payment is Being Processed...</h1>
    <p>Please do not close this page. Your invoice will be ready shortly.</p>
    <div>
        <img src="data:image/png;base64," alt="Processing..." style="width: 100px; height: 100px;" />
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    var options = {
        "key": "@ViewBag.RazorpayKey", 
        "amount": @ViewBag.Amount, // Amount in paisa
        "currency": "INR",
        "name": "Masstech Business Solutions Pvt.Ltd",
        "description": "Checkout Payment",
        "order_id": "@ViewBag.OrderId",
        "handler": function (response) {
            // Successful payment response
            alert("Payment successful. Payment ID: " + response.razorpay_payment_id);
            window.location.href = "/Bills/Success?paymentId=" + response.razorpay_payment_id + "&id=" + @ViewBag.bill_id;
        },
        "prefill": {
            "name": "Krish Kheloji",
            "email": "@ViewBag.Email",
            "contact": "@ViewBag.Contact"
        },
        "theme": {
            "color": "#F37254"
        }
    };

    var rzp1 = new Razorpay(options);
    rzp1.open();
</script>
